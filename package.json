{
  "name": "nagare",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "scripts": {
    "gen:ts": "go run ./scripts/ts.go",
    "gateway:dev": "cd ./cli && go run -tags debug . gateway start -d",
    "gateway:stop": "cd ./cli && go run -tags debug . gateway stop",
    "build": "./build.sh",
    "cli:run": "cd ./cli && go run -tags debug . ",
    "web:dev": "pnpm --filter ./client/web dev ",
    "web:build": "pnpm --filter ./client/web build ",
    "web:lint": "pnpm  --filter ./client/web lint ",
    "web:format": "pnpm --filter ./client/web format ",
    "web:preview": "pnpm --filter ./client/web preview",
    "desktop:dev": "cd ./client/desktop && wails3 dev",
    "desktop:build": "cd ./client/desktop && wails3 build"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.1"
  }
}
